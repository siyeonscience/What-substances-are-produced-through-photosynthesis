  const seen=new Set();
  function openObservation(){
    const m=$('#obsModal'), tabs=$('#obsTabs'), field=$('#obsField'), cap=$('#obsCap'),
      prog=$('#obsProgress'), next=$('#toConcl');
    tabs.innerHTML=''; seen.clear(); next.disabled=true;
    cap.innerHTML='표본을 선택하세요.'; field.querySelectorAll('svg').forEach(e=>e.remove());
    prog.textContent='0 / 4 관찰';
    OBS.forEach(o=>{
      const t=document.createElement('div'); t.className='obs-tab'; t.textContent=o.tab;
      t.onclick=()=>{
        $$('.obs-tab',tabs).forEach(x=>x.classList.remove('active')); t.classList.add('active');
        renderField(field,o.kind); cap.innerHTML=o.cap;
        seen.add(o.key); prog.textContent=seen.size+' / 4 관찰';
        if(seen.size===4) next.disabled=false;
      };
      tabs.appendChild(t);
    });
    next.onclick=()=>{ m.classList.remove('show'); openFinalQuestion(); };
    m.classList.add('show');
  }
  function renderField(field,kind){
    field.querySelectorAll('svg').forEach(e=>e.remove());
    const ns='http://www.w3.org/2000/svg';
    const svg=document.createElementNS(ns,'svg'); svg.setAttribute('viewBox','0 0 220 220');
    svg.setAttribute('width','100%'); svg.setAttribute('height','100%');
    // background tint
    let bg = kind==='blue' ? '#dfe3f2' : kind==='brown' ? '#efe4d3' : '#e7f2e2';
    const rect=document.createElementNS(ns,'rect'); rect.setAttribute('width','220');rect.setAttribute('height','220');rect.setAttribute('fill',bg);
    svg.appendChild(rect);
    // draw cells (grid of rounded rects)
    const cellFill = kind==='blue' ? '#3a468f' : kind==='brown' ? '#c9a06a' : '#cfe6c4';
    const cellStroke = kind==='blue' ? '#26326b' : kind==='brown' ? '#8a5a2b' : '#7fbf82';
    for(let r=0;r<4;r++){for(let c=0;c<4;c++){
      const x=14+c*50+((r%2)?10:0), y=14+r*50;
      const cell=document.createElementNS(ns,'rect');
      cell.setAttribute('x',x);cell.setAttribute('y',y);cell.setAttribute('width',44);cell.setAttribute('height',44);
      cell.setAttribute('rx',12);cell.setAttribute('fill',cellFill);cell.setAttribute('stroke',cellStroke);cell.setAttribute('stroke-width',2.5);
      svg.appendChild(cell);
      // chloroplasts / stained granules
      const dots = kind==='green'?5 : kind==='blue'?6 : 3;
      for(let i=0;i<dots;i++){
        const d=document.createElementNS(ns,'ellipse');
        d.setAttribute('cx',x+8+Math.random()*28); d.setAttribute('cy',y+8+Math.random()*28);
        d.setAttribute('rx',4+Math.random()*2); d.setAttribute('ry',3+Math.random()*2);
        d.setAttribute('fill', kind==='green'?'#2f9e44' : kind==='blue'?'#1a2255' : '#8a5a2b');
        d.setAttribute('opacity', kind==='brown'?'.5':'.92');
        svg.appendChild(d);
      }
    }}
    // vignette
    const defs=document.createElementNS(ns,'defs');
    const vg=document.createElementNS(ns,'radialGradient'); vg.setAttribute('id','vg');
    const s1=document.createElementNS(ns,'stop'); s1.setAttribute('offset','68%'); s1.setAttribute('stop-color','#000'); s1.setAttribute('stop-opacity','0');
    const s2=document.createElementNS(ns,'stop'); s2.setAttribute('offset','100%'); s2.setAttribute('stop-color','#000'); s2.setAttribute('stop-opacity','0.32');
    vg.appendChild(s1); vg.appendChild(s2); defs.appendChild(vg); svg.appendChild(defs);
    const ov=document.createElementNS(ns,'rect'); ov.setAttribute('width','220');ov.setAttribute('height','220');ov.setAttribute('fill','url(#vg)');
    svg.appendChild(ov);
    field.appendChild(svg);
  }

  /* ===================== scene switching ===================== */
  async function showScene(sc){
    $$('.scene').forEach(s=>{ if(s!==sc){ s.classList.remove('fade-in'); } });
    await wait(120);
    $$('.scene').forEach(s=>{ if(s!==sc) s.classList.remove('show'); });
    sc.classList.add('show'); requestAnimationFrame(()=>sc.classList.add('fade-in'));
    await wait(500);
  }

  /* ===================== boot / restart ===================== */
  function reset(){
    disarm(); ['qModal','obsModal','conclModal'].forEach(id=>$('#'+id).classList.remove('show'));
    $$('.scene').forEach(s=>{s.classList.remove('show','fade-in');s.innerHTML='';});
    trayEl=null; $('#daynight').style.opacity='0';
    answers.q1=''; answers.q2=''; $('#stuName').value='';
    $('#title').style.display='flex';
  }
  $('#startBtn').onclick=()=>{ $('#title').style.display='none'; runPrep(); };
  $('#restartBtn').onclick=()=>{ reset(); };
  $('#againBtn').onclick=()=>{ reset(); };
  $('#saveImg').onclick=()=>{ try{ saveReportImage(); }catch(e){ console.error(e); } };
})();
</script>
</body>
