  // wrap text to a max pixel width (works for Korean: breaks per character)
  function wrapText(ctx,text,maxW){
    const lines=[]; 
    (text||'').split('\n').forEach(para=>{
      let line='';
      for(const ch of para){
        if(ctx.measureText(line+ch).width>maxW && line){ lines.push(line); line=ch; }
        else line+=ch;
      }
      lines.push(line);
    });
    return lines;
  }
  function saveReportImage(){
    const name=($('#stuName').value||'').trim();
    const scale=2;               // crisp on retina
    const W=880, pad=44, contentW=W-pad*2;
    const c=document.createElement('canvas');
    const ctx=c.getContext('2d');
    const FS='"Pretendard","Apple SD Gothic Neo","Noto Sans KR",sans-serif';
    // pre-measure to compute height
    const blocks=[
      {n:'정리 ①', q:Q1TEXT, a:answers.q1||'(작성한 답변 없음)'},
      {n:'정리 ②', q:Q2TEXT, a:answers.q2||'(작성한 답변 없음)'},
    ];
    ctx.font=`700 19px ${FS}`;
    const measured=blocks.map(b=>{
      const ql=wrapText(ctx,b.n+'. '+b.q,contentW-36);
      ctx.font=`500 20px ${FS}`;
      const al=wrapText(ctx,b.a,contentW-36);
      ctx.font=`700 19px ${FS}`;
      return {ql,al};
    });
    let h=pad+70+ (name?38:14) +20;
    measured.forEach(m=>{ h+= 22 + m.ql.length*28 + 14 + m.al.length*30 + 24 + 22; });
    h+=pad;
    c.width=W*scale; c.height=h*scale; ctx.scale(scale,scale);
    // background
    ctx.fillStyle='#fff7ee'; ctx.fillRect(0,0,W,h);
    ctx.fillStyle='#eaf7ef'; roundRect(ctx,pad-16,pad-16,W-2*(pad-16),h-2*(pad-16),24); ctx.fill();
    // header
    ctx.fillStyle='#46b869'; ctx.font=`800 15px ${FS}`;
    ctx.fillText('🌿  광합성으로 만들어지는 물질 확인 · 탐구 정리', pad, pad+18);
    ctx.fillStyle='#42505a'; ctx.font=`900 26px ${FS}`;
    ctx.fillText('나의 탐구 정리 보고서', pad, pad+52);
    let y=pad+78;
    if(name){ ctx.fillStyle='#7a8992'; ctx.font=`700 17px ${FS}`; ctx.fillText('이름 : '+name, pad, y+8); y+=34; }
    y+=6;
    // blocks
    blocks.forEach((b,i)=>{
      const m=measured[i];
      const blkH=18 + m.ql.length*28 + 12 + m.al.length*30 + 20;
      ctx.fillStyle='#ffffff'; roundRect(ctx,pad,y,contentW,blkH,18); ctx.fill();
      ctx.strokeStyle='#ecdfd0'; ctx.lineWidth=2; roundRect(ctx,pad,y,contentW,blkH,18); ctx.stroke();
      let ty=y+30;
      ctx.fillStyle='#2f9e50'; ctx.font=`800 19px ${FS}`;
      m.ql.forEach(l=>{ ctx.fillText(l, pad+18, ty); ty+=28; });
      ty+=6;
      ctx.fillStyle='#42505a'; ctx.font=`500 20px ${FS}`;
      m.al.forEach(l=>{ ctx.fillText(l, pad+18, ty); ty+=30; });
      y+=blkH+22;
    });
    // download
    const a=document.createElement('a');
    a.download=(name?name+'_':'')+'광합성_탐구정리.png';
    a.href=c.toDataURL('image/png'); a.click();
  }
  function roundRect(ctx,x,y,w,h,r){
    ctx.beginPath();
    ctx.moveTo(x+r,y); ctx.arcTo(x+w,y,x+w,y+h,r); ctx.arcTo(x+w,y+h,x,y+h,r);
    ctx.arcTo(x,y+h,x,y,r); ctx.arcTo(x,y,x+w,y,r); ctx.closePath();
  }

