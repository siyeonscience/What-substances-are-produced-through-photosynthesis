<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>광합성으로 만들어지는 물질 확인하기</title>
<link rel="preconnect" href="https://cdn.jsdelivr.net">
<link href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.css" rel="stylesheet">
<style>
:root{
  --ink:#42505a; --ink-soft:#7a8992; --line:#ecdfd0;
  --bg1:#fff6ea; --bg2:#e9f7ef;
  --panel:#ffffff; --panel-2:#fbf3e8;
  --bench:#f7dcac; --bench-dark:#ecc07f; --bench-edge:#d9a259;
  --glass:#f2fafc; --glass-line:#a9c8d6; --sheen:#ffffff;
  --water:#7fd6ec; --water-2:#bceff8; --ethanol:#eef5f0; --ethanol-green:#93c85a;
  --weed:#46b869; --weed-dark:#2f9e50; --weed-pale:#c3e3cc;
  --amber:#ffb13a; --amber-2:#ffdca0; --glow:rgba(255,177,58,.6);
  --ember:#ff7a45; --flame:#ffd54a;
  --iodine:#7b57c4; --stain-blue:#2b3a86; --stain-brown:#9a6a34;
  --ok:#46b869; --shadow:0 12px 32px rgba(120,110,90,.18);
  --r:26px;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;height:100%}
body{
  font-family:'Pretendard','Apple SD Gothic Neo','Noto Sans KR',system-ui,sans-serif;
  color:var(--ink); overflow:hidden; user-select:none;
  background:
    radial-gradient(circle at 12% 18%, rgba(255,214,165,.45), transparent 26%),
    radial-gradient(circle at 88% 12%, rgba(150,224,185,.42), transparent 26%),
    radial-gradient(circle at 78% 82%, rgba(255,196,210,.35), transparent 26%),
    radial-gradient(circle at 20% 88%, rgba(178,236,246,.4), transparent 30%),
    linear-gradient(180deg,var(--bg1),var(--bg2));
}
#app{position:fixed;inset:0;display:flex;flex-direction:column}

/* ---------- top eyebrow + guide ---------- */
#topbar{
  position:relative;z-index:40;display:flex;align-items:center;gap:10px;
  padding:14px 20px 8px;flex-wrap:wrap;
}
.eyebrow{
  font-size:14px;font-weight:800;letter-spacing:.02em;color:#fff;
  background:linear-gradient(135deg,#46b869,#6fd493);
  padding:8px 16px;border-radius:999px;box-shadow:0 6px 16px rgba(70,184,105,.32);
}
.eyebrow small{opacity:.85;font-weight:700}
#phaseTitle{font-size:18px;font-weight:800;color:var(--ink)}
.spacer{flex:1}
.mini-btn{
  border:1.5px solid var(--line);background:#fff;color:var(--ink-soft);
  font-family:inherit;font-weight:700;font-size:13px;border-radius:999px;
  padding:7px 13px;cursor:pointer;box-shadow:0 2px 6px rgba(0,0,0,.05)
}
.mini-btn:active{transform:scale(.96)}

/* ---------- stage ---------- */
#stage{position:relative;flex:1;overflow:hidden}
.bench{
  position:absolute;left:0;right:0;bottom:0;height:34%;
  background:linear-gradient(180deg,var(--bench) 0%,var(--bench-dark) 76%,var(--bench-edge) 100%);
  border-radius:44px 44px 0 0;
  box-shadow:inset 0 8px 22px rgba(255,255,255,.4), inset 0 -26px 40px rgba(150,110,60,.14);
}
.bench::before{content:"";position:absolute;top:0;left:5%;right:5%;height:6px;border-radius:6px;background:rgba(255,255,255,.5)}

.scene{position:absolute;inset:0;display:none;opacity:0;transition:opacity .5s ease}
.scene.show{display:block}
.scene.fade-in{opacity:1}

/* generic guide caption */
#guidebar{
  position:absolute;left:50%;bottom:22px;transform:translateX(-50%);
  z-index:35;display:flex;align-items:center;gap:10px;
  background:#fff;color:var(--ink);font-weight:800;font-size:16px;
  padding:12px 22px 12px 16px;border-radius:999px;
  box-shadow:var(--shadow);border:2.5px solid #ffe6bf;
  max-width:92vw;text-align:center;transition:opacity .35s, transform .35s;
}
#guidebar.hide{opacity:0;transform:translateX(-50%) translateY(14px);pointer-events:none}
.mascot{font-size:22px;animation:bob 1.5s ease-in-out infinite;flex:none}
@keyframes bob{0%,100%{transform:translateY(0) rotate(-6deg)}50%{transform:translateY(-4px) rotate(6deg)}}

/* ---------- tappable highlight (traces the object's own outline) ---------- */
.tappable{cursor:pointer}
.tappable.active,.glow-cue{animation:glowPulse 1.25s ease-in-out infinite}
@keyframes glowPulse{
  0%,100%{filter:drop-shadow(1.6px 0 0 var(--amber)) drop-shadow(-1.6px 0 0 var(--amber)) drop-shadow(0 1.6px 0 var(--amber)) drop-shadow(0 -1.6px 0 var(--amber)) drop-shadow(0 0 3px var(--glow))}
  50%{filter:drop-shadow(1.6px 0 0 var(--amber)) drop-shadow(-1.6px 0 0 var(--amber)) drop-shadow(0 1.6px 0 var(--amber)) drop-shadow(0 -1.6px 0 var(--amber)) drop-shadow(0 0 13px var(--amber))}
}
.tappable.active:active{transform:scale(.96)}
.draggable{touch-action:none;cursor:grab}
.draggable.grabbing{cursor:grabbing}

/* ---------- test tube ---------- */
.rack{position:absolute;width:230px;height:120px}
.rack .board{position:absolute;bottom:0;left:0;right:0;height:40px;border-radius:16px;
  background:linear-gradient(180deg,#e4c79a,#c79a6b);box-shadow:0 8px 16px rgba(0,0,0,.18), inset 0 2px 0 rgba(255,255,255,.5)}
.rack .board.top{bottom:78px;height:16px}
.rack .post{position:absolute;bottom:0;width:14px;height:96px;border-radius:6px;
  background:linear-gradient(90deg,#c79a6b,#a87c4f)}
.rack .post.l{left:16px}.rack .post.r{right:16px}
.rack .socket{position:absolute;bottom:86px;width:60px;height:12px;border-radius:50%;
  background:rgba(0,0,0,.22)}

.tube{position:absolute;width:74px;height:238px;z-index:5;
  transition:transform .6s cubic-bezier(.2,.7,.2,1), opacity .5s}
.tube .glass{position:absolute;inset:0;overflow:hidden;
  border:3px solid var(--glass-line);border-top:none;
  border-radius:8px 8px 34px 34px;
  background:linear-gradient(100deg,rgba(255,255,255,.65),rgba(190,220,232,.28) 45%,rgba(255,255,255,.5));
  backdrop-filter:blur(1px)}
.tube .rim{position:absolute;top:-4px;left:-3px;right:-3px;height:9px;border-radius:5px;
  background:linear-gradient(180deg,#dff0f7,#b7d3df);border:2px solid var(--glass-line)}
.tube .fill{position:absolute;left:0;right:0;bottom:0;height:52%;
  background:linear-gradient(180deg,var(--water-2),var(--water));
  transition:height .7s ease, background .7s ease}
.tube .fill::before{content:"";position:absolute;top:-6px;left:0;right:0;height:8px;border-radius:50%;background:rgba(255,255,255,.4)}
.tube .weed{position:absolute;left:50%;bottom:6px;transform:translateX(-50%) translateY(24px);
  opacity:0;transition:opacity .5s ease, transform .6s ease, filter .8s ease;width:44px;height:180px}
.tube.has-weed .weed{opacity:1;transform:translateX(-50%) translateY(0)}
.tube .bubbles{position:absolute;inset:0;pointer-events:none}
.tube .lid{position:absolute;top:-6px;left:-4px;right:-4px;height:20px;border-radius:7px;
  background:linear-gradient(180deg,#f6a541,#e07d1e);border:2px solid #c9691a;
  transform:translateY(-30px) scale(.9);opacity:0;transition:.45s;z-index:6}
.tube.lid-on .lid{transform:none;opacity:1}
.tube .foil{position:absolute;top:16px;left:-5px;right:-5px;bottom:-3px;border-radius:8px 8px 36px 36px;
  background:repeating-linear-gradient(115deg,#c9ced3 0 6px,#e7ebee 6px 12px,#b6bcc2 12px 18px);
  box-shadow:inset 0 0 14px rgba(0,0,0,.2);opacity:0;transform:scaleY(.2);transform-origin:top;
  transition:.55s ease;z-index:7}
.tube.foil-on .foil{opacity:1;transform:none}
.tube .badge{position:absolute;top:34px;left:50%;transform:translateX(-50%);z-index:8;
  width:30px;height:30px;border-radius:50%;background:#fff;border:2.5px solid var(--ink);
  display:flex;align-items:center;justify-content:center;font-weight:900;font-size:16px;color:var(--ink);
  box-shadow:0 3px 8px rgba(0,0,0,.15)}

.bubble{position:absolute;bottom:12%;border-radius:50%;
  background:radial-gradient(circle at 35% 30%,#fff,rgba(255,255,255,.5));
  animation:rise linear forwards}
@keyframes rise{0%{transform:translateY(0) scale(.6);opacity:0}
  15%{opacity:.9}100%{transform:translateY(-120px) scale(1);opacity:0}}

.straw{position:absolute;z-index:9;width:13px;height:198px;border-radius:8px;
  background:linear-gradient(90deg,#ff7d94,#ffd7de 42%,#ff9db0);
  border:1.5px solid #ef5f7a;transform-origin:bottom center;
  transform:translateY(-78px) rotate(9deg);opacity:1;transition:.5s ease}
.straw.in{transform:translateY(0) rotate(9deg);opacity:1}

/* ---------- incense (draggable) ---------- */
.incense{position:absolute;z-index:12;width:50px;height:196px;transition:opacity .4s ease, left .45s ease, top .45s ease}
.incense .stick{position:absolute;left:50%;top:20px;transform:translateX(-50%);width:8px;height:150px;border-radius:5px;
  background:linear-gradient(90deg,#8a5a3a,#c98a5a 50%,#8a5a3a)}
.incense .ember{position:absolute;left:50%;top:14px;transform:translateX(-50%);
  width:13px;height:13px;border-radius:50%;background:var(--ember);
  box-shadow:0 0 10px 3px rgba(255,107,53,.85);opacity:0;transition:.4s}
.incense.lit .ember{opacity:1;animation:emberglow 1.2s infinite}
@keyframes emberglow{0%,100%{box-shadow:0 0 8px 2px rgba(255,107,53,.7)}50%{box-shadow:0 0 15px 6px rgba(255,180,80,.9)}}
.incense .flame{position:absolute;left:50%;top:-12px;transform:translateX(-50%);
  width:16px;height:34px;border-radius:50% 50% 50% 50%/60% 60% 40% 40%;
  background:radial-gradient(circle at 50% 70%,#fff 0%,var(--flame) 40%,var(--ember) 90%);
  opacity:0;transform-origin:bottom center}
.incense.burning .flame{opacity:1;animation:flick .25s infinite alternate}
@keyframes flick{from{transform:translateX(-50%) scaleY(1) rotate(-2deg)}to{transform:translateX(-52%) scaleY(1.18) rotate(3deg)}}
.incense .smoke{position:absolute;left:50%;top:4px;width:6px;height:6px;border-radius:50%;background:rgba(180,180,180,.5);opacity:0}
.incense.smoking .smoke{animation:smoke 2s infinite}
@keyframes smoke{0%{opacity:.5;transform:translate(-50%,0) scale(.6)}100%{opacity:0;transform:translate(-30%,-60px) scale(2.2)}}
.incense .grip{position:absolute;left:50%;bottom:2px;transform:translateX(-50%);width:30px;height:22px;border-radius:11px;
  background:linear-gradient(180deg,#ffe0ad,#eaa94e);border:2.5px solid #cf8a2e;box-shadow:0 3px 6px rgba(0,0,0,.16)}
.incense .lbl{position:absolute;left:50%;bottom:-20px;transform:translateX(-50%);font-size:12px;font-weight:800;color:#b06f28;white-space:nowrap}
.flare-fx{position:absolute;z-index:20;width:64px;height:64px;border-radius:50%;pointer-events:none;
  background:radial-gradient(circle,#fff 0%,var(--flame) 35%,var(--ember) 70%,transparent 72%);opacity:0}
.flare-fx.go{animation:flareUp 1.1s ease forwards}
@keyframes flareUp{0%{opacity:0;transform:scale(.3)}25%{opacity:1;transform:scale(1.25)}100%{opacity:0;transform:scale(1.6)}}
.puff-fx{position:absolute;z-index:20;width:20px;height:20px;border-radius:50%;pointer-events:none;
  background:rgba(190,190,190,.55);opacity:0}
.puff-fx.go{animation:puff 1s ease forwards}
@keyframes puff{0%{opacity:.6;transform:translateY(0) scale(.5)}100%{opacity:0;transform:translateY(-34px) scale(1.8)}}

/* ---------- hotplate / beaker ---------- */
.hotplate{position:absolute;z-index:4;width:220px;height:150px}
.hotplate .base{position:absolute;bottom:0;left:0;right:0;height:56px;border-radius:14px;
  background:linear-gradient(180deg,#5b6870,#39434a);box-shadow:0 10px 20px rgba(0,0,0,.25)}
.hotplate .plate{position:absolute;bottom:44px;left:24px;right:24px;height:20px;border-radius:8px;
  background:radial-gradient(circle at 50% 50%,#7a848b,#4a545b);transition:.6s}
.hotplate.on .plate{background:radial-gradient(circle at 50% 50%,#ff7a45,#b03a1a);box-shadow:0 0 24px rgba(255,90,40,.6)}
.hotplate .knob{position:absolute;bottom:12px;right:16px;width:22px;height:22px;border-radius:50%;
  background:radial-gradient(circle at 40% 35%,#cfd6da,#7c858b);border:2px solid #2c343a}
.hotplate .beaker{position:absolute;bottom:60px;left:50%;transform:translateX(-50%);
  width:142px;height:108px;border:3px solid var(--glass-line);border-top:none;
  border-radius:6px 6px 22px 22px;overflow:hidden;
  background:linear-gradient(100deg,rgba(255,255,255,.55),rgba(200,225,235,.25))}
.hotplate .bwater{position:absolute;left:0;right:0;bottom:0;height:58%;
  background:linear-gradient(180deg,var(--water-2),var(--water));transition:background .8s}
.hotplate.on .bwater{background:linear-gradient(180deg,#ffe1c2,#ffb98a)}
.heatwave{position:absolute;bottom:64px;width:8px;height:26px;border-radius:6px;
  background:linear-gradient(180deg,rgba(255,150,80,.6),transparent);opacity:0}
.hotplate.on .heatwave{animation:heat 1.4s infinite}
@keyframes heat{0%{opacity:0;transform:translateY(6px) scaleY(.6)}40%{opacity:.8}100%{opacity:0;transform:translateY(-20px) scaleY(1.3)}}
.heatpill{position:absolute;top:-2px;right:-58px;background:#fff;border:2px solid #ffd8a6;
  border-radius:999px;padding:6px 12px;font-size:12px;font-weight:800;color:#d97a1a;box-shadow:var(--shadow);
  display:flex;align-items:center;gap:5px;opacity:0;transition:.4s}
.heatpill::before{content:"♨️";font-size:14px}
.hotplate.on .heatpill{opacity:1}
.steam{position:absolute;width:10px;height:34px;border-radius:8px;
  background:linear-gradient(180deg,rgba(255,255,255,.7),rgba(255,255,255,0));opacity:0;filter:blur(2px)}
.steam.s1{bottom:150px;left:60px}.steam.s2{bottom:158px;left:98px}.steam.s3{bottom:150px;left:136px}
.hotplate.on .steam{animation:steam 2.2s infinite}
.hotplate.on .steam.s2{animation-delay:.7s}
.hotplate.on .steam.s3{animation-delay:1.3s}
@keyframes steam{0%{opacity:0;transform:translateY(8px) scaleY(.6)}30%{opacity:.7}100%{opacity:0;transform:translateY(-40px) translateX(-6px) scaleY(1.4)}}
.mini-tube+.bbubbles,.beaker .bbubbles{position:absolute;left:0;right:0;bottom:0;height:58%;pointer-events:none}
.beaker .bbubbles{position:absolute;left:0;right:0;bottom:0;height:58%;pointer-events:none}
.bbub{position:absolute;bottom:0;border-radius:50%;background:radial-gradient(circle at 35% 30%,#fff,rgba(255,255,255,.5));
  animation:brise linear forwards}
@keyframes brise{0%{transform:translateY(0) scale(.6);opacity:0}20%{opacity:.85}100%{transform:translateY(-52px) scale(1);opacity:0}}
.mini-tube{position:absolute;width:42px;height:140px;z-index:5;transition:transform .6s cubic-bezier(.2,.7,.2,1),opacity .5s}
.mini-tube .g{position:absolute;inset:0;overflow:hidden;border:2.5px solid var(--glass-line);border-top:none;border-radius:5px 5px 20px 20px;
  background:linear-gradient(100deg,rgba(255,255,255,.6),rgba(200,225,235,.25))}
.mini-tube .lf{position:absolute;left:0;right:0;bottom:0;height:0;background:var(--ethanol);transition:height .6s ease, background .8s}
.mini-tube.filled .lf{height:66%}
.mini-tube.green .lf{background:linear-gradient(180deg,#c7e29a,var(--ethanol-green))}
.mini-tube .mw{position:absolute;left:50%;bottom:6px;transform:translateX(-50%);width:26px;height:92px;opacity:0;transition:filter 1.2s ease, opacity .6s}
.mini-tube.has-mw .mw{opacity:1}
.mini-tube.decolor .mw{filter:grayscale(1) brightness(1.7) opacity(.35)}
.mini-tube .b{position:absolute;top:32px;left:50%;transform:translateX(-50%);width:20px;height:20px;border-radius:50%;
  background:#fff;border:2px solid var(--ink);display:flex;align-items:center;justify-content:center;font-weight:900;font-size:12px;z-index:3}

/* ---------- bottles ---------- */
.bottle{position:absolute;z-index:9;width:66px;height:110px}
.bottle .body{position:absolute;bottom:0;left:0;right:0;height:82px;border-radius:12px;
  background:linear-gradient(180deg,#ffffff,#eef2f4);border:2.5px solid var(--line);box-shadow:var(--shadow)}
.bottle .neck{position:absolute;top:6px;left:50%;transform:translateX(-50%);width:24px;height:22px;
  background:#fff;border:2.5px solid var(--line);border-bottom:none;border-radius:6px 6px 0 0}
.bottle .cap{position:absolute;top:0;left:50%;transform:translateX(-50%);width:30px;height:12px;border-radius:5px;
  background:#6b7883}
.bottle .lab{position:absolute;bottom:16px;left:6px;right:6px;text-align:center;font-size:11px;font-weight:800;
  color:var(--ink);background:#fff;border-radius:6px;padding:4px 2px;line-height:1.15;border:1px solid var(--line)}
.bottle.iodine .cap{background:#4a2f7a}
.bottle.iodine .lab{color:#4a2f7a}
.drop{position:absolute;z-index:14;width:10px;height:14px;border-radius:50% 50% 50% 50%/60% 60% 40% 40%;
  background:#8a5a2b;opacity:0}
.drop.go{animation:dropfall .8s ease forwards}
@keyframes dropfall{0%{opacity:1;transform:translateY(0) scale(.7)}80%{opacity:1;transform:translateY(70px) scale(1)}100%{opacity:0;transform:translateY(78px) scale(1.4)}}

/* ---------- slides / specimens ---------- */
.slide{position:absolute;z-index:6;width:120px;height:34px;border-radius:6px;
  background:linear-gradient(180deg,rgba(233,246,250,.9),rgba(200,225,235,.75));
  border:2px solid var(--glass-line);box-shadow:var(--shadow);transition:.5s;opacity:0;transform:translateY(10px)}
.slide.on{opacity:1;transform:none}
.slide .leaf{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:17px;height:11px;
  border-radius:60% 60% 50% 50%/70% 70% 40% 40%;background:var(--weed);transition:background 1s, filter 1s}
.slide.decolor .leaf{background:#e6d9b0;filter:none}
.slide.blue .leaf{background:var(--stain-blue)}
.slide.brown .leaf{background:var(--stain-brown)}
.slide .cover{position:absolute;top:50%;left:50%;width:28px;height:28px;border-radius:3px;
  border:1.5px solid rgba(255,255,255,.95);
  background:linear-gradient(120deg,rgba(255,255,255,.55),rgba(200,225,235,.2));
  box-shadow:0 1px 4px rgba(0,0,0,.15);
  transform:translate(-50%,-50%) translate(46px,-34px) rotate(-8deg);opacity:0;transition:.5s}
.slide.covered .cover{transform:translate(-50%,-50%) rotate(0deg);opacity:1}
.slide .tag{position:absolute;top:-20px;left:0;font-size:12px;font-weight:800;color:var(--ink-soft)}

/* specimen tray */
.tray{position:absolute;top:14px;right:16px;z-index:8;width:150px;
  background:rgba(255,255,255,.9);border:2px solid var(--line);border-radius:16px;padding:10px;
  box-shadow:var(--shadow);opacity:0;transform:translateY(-8px);transition:.4s}
.tray.on{opacity:1;transform:none}
.tray h4{margin:0 0 8px;font-size:13px;color:var(--ink-soft);text-align:center}
.tray .row{display:flex;gap:6px;margin-bottom:6px}
.chip{flex:1;font-size:11px;font-weight:800;text-align:center;padding:6px 2px;border-radius:8px;
  background:var(--panel-2);border:1.5px solid var(--line);color:var(--ink)}

/* ---------- clock ---------- */
.clock{position:absolute;z-index:9;width:96px;height:96px;border-radius:50%;
  background:radial-gradient(circle at 40% 35%,#fff,#e7eef2);border:5px solid #7a8a93;box-shadow:var(--shadow)}
.clock .h,.clock .m{position:absolute;left:50%;bottom:50%;transform-origin:bottom center;border-radius:4px;background:var(--ink)}
.clock .h{width:5px;height:24px;transform:translateX(-50%) rotate(0deg)}
.clock .m{width:3px;height:34px;transform:translateX(-50%) rotate(0deg)}
.clock .pin{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:10px;height:10px;border-radius:50%;background:var(--amber)}
.clock.spin .h{animation:spinH 3.4s linear forwards}
.clock.spin .m{animation:spinM 3.4s linear forwards}
@keyframes spinH{to{transform:translateX(-50%) rotate(720deg)}}
@keyframes spinM{to{transform:translateX(-50%) rotate(8640deg)}}

/* ---------- microscope ---------- */
.scope{position:absolute;z-index:9;width:150px;height:200px}
.scope svg{width:100%;height:100%;filter:drop-shadow(0 8px 14px rgba(0,0,0,.18))}

/* day/night overlay */
#daynight{position:absolute;inset:0;z-index:30;pointer-events:none;background:#05122b;opacity:0;transition:opacity 1s}
#daynight .sky{position:absolute;inset:0;background:radial-gradient(circle at 80% 20%,rgba(255,255,255,.15),transparent 40%)}
#daynight .star{position:absolute;width:3px;height:3px;border-radius:50%;background:#fff;opacity:.9}
#daynight .sun{position:absolute;top:30%;left:15%;width:60px;height:60px;border-radius:50%;
  background:radial-gradient(circle,#fff,#ffd166 60%,#ffb703);box-shadow:0 0 40px rgba(255,200,80,.9);opacity:0;transition:.8s}

/* ---------- title scene ---------- */
#title{position:absolute;inset:0;z-index:50;display:flex;flex-direction:column;align-items:center;justify-content:center;
  text-align:center;padding:24px;
  background:
    radial-gradient(circle at 18% 22%, rgba(255,214,165,.5), transparent 30%),
    radial-gradient(circle at 82% 78%, rgba(150,224,185,.5), transparent 32%),
    linear-gradient(180deg,#fff7ee,#e6f6ec)}
#title .plant{font-size:76px;margin-bottom:6px;animation:sway 3s ease-in-out infinite;filter:drop-shadow(0 8px 10px rgba(90,150,100,.25))}
@keyframes sway{0%,100%{transform:rotate(-6deg)}50%{transform:rotate(6deg)}}
#title .eyebrow2{font-size:15px;font-weight:800;color:#46b869;letter-spacing:.04em;margin-bottom:12px;
  background:#fff;padding:7px 16px;border-radius:999px;box-shadow:0 6px 16px rgba(70,184,105,.2)}
#title h1{font-size:clamp(27px,5vw,46px);font-weight:900;line-height:1.25;margin:0 0 10px;color:var(--ink)}
#title p{color:var(--ink-soft);font-weight:700;font-size:16px;margin:0 0 34px}
.big-btn{border:none;cursor:pointer;font-family:inherit;font-weight:900;font-size:20px;color:#fff;
  padding:17px 46px;border-radius:999px;background:linear-gradient(135deg,#46b869,#63cf88);
  box-shadow:0 12px 26px rgba(70,184,105,.42), inset 0 -4px 0 rgba(0,0,0,.08);transition:transform .15s}
.big-btn:hover{transform:translateY(-2px)}
.big-btn:active{transform:scale(.96)}
.big-btn.amber{background:linear-gradient(135deg,#ffb13a,#ffc766);box-shadow:0 12px 26px rgba(255,177,58,.42), inset 0 -4px 0 rgba(0,0,0,.08)}

/* ---------- popup / modal ---------- */
.modal{position:absolute;inset:0;z-index:60;display:none;align-items:center;justify-content:center;
  background:rgba(20,35,45,.5);backdrop-filter:blur(3px);padding:20px}
.modal.show{display:flex;animation:pop .35s ease}
@keyframes pop{from{opacity:0}to{opacity:1}}
.card{background:#fff;border-radius:30px;box-shadow:var(--shadow);border:2.5px solid #ffe6bf;padding:26px;max-width:560px;width:100%;
  animation:cardpop .4s cubic-bezier(.2,.9,.3,1.2)}
@keyframes cardpop{from{transform:translateY(20px) scale(.96);opacity:0}to{transform:none;opacity:1}}
.card .q-eyebrow{font-size:13px;font-weight:800;color:#2f9e44;margin-bottom:8px}
.card h3{margin:0 0 16px;font-size:20px;line-height:1.45;color:var(--ink)}
.card textarea{width:100%;min-height:120px;border:2px solid var(--line);border-radius:14px;padding:14px;
  font-family:inherit;font-size:16px;resize:vertical;color:var(--ink)}
.card textarea:focus{outline:none;border-color:var(--amber)}
.card .actions{display:flex;justify-content:flex-end;margin-top:16px}
.card .submit{border:none;cursor:pointer;font-family:inherit;font-weight:800;font-size:16px;color:#fff;
  padding:13px 30px;border-radius:999px;background:linear-gradient(135deg,#46b869,#63cf88);transition:.15s;box-shadow:inset 0 -3px 0 rgba(0,0,0,.08)}
.card .submit:disabled{background:#c6d3da;cursor:not-allowed}
.card .submit:not(:disabled):active{transform:scale(.96)}

/* observation modal */
.obs-grid{display:flex;gap:10px;flex-wrap:wrap;justify-content:center;margin-bottom:16px}
.obs-tab{cursor:pointer;border:2px solid var(--line);background:var(--panel-2);border-radius:12px;
  padding:9px 12px;font-weight:800;font-size:13px;color:var(--ink);transition:.15s}
.obs-tab.active{border-color:var(--amber);background:#fff4e2;color:#b56a00}
.field-wrap{display:flex;flex-direction:column;align-items:center;gap:10px}
.field{width:230px;height:230px;border-radius:50%;overflow:hidden;border:8px solid #2b3942;
  box-shadow:inset 0 0 40px rgba(0,0,0,.25), var(--shadow);background:#eef4e7;position:relative}
.field .mag{position:absolute;top:8px;left:50%;transform:translateX(-50%);z-index:3;
  background:rgba(0,0,0,.55);color:#fff;font-size:12px;font-weight:800;padding:3px 10px;border-radius:999px}
.obs-caption{font-size:15px;font-weight:700;color:var(--ink);text-align:center;min-height:24px}
.obs-caption b{color:var(--iodine)}

/* conclusion */
.concl{text-align:center}
.concl .big{font-size:22px;font-weight:900;margin:6px 0 14px}
.concl .grid{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-bottom:18px}
.concl .box{flex:1;min-width:180px;background:var(--panel-2);border:2px solid var(--line);border-radius:16px;padding:14px}
.concl .box h5{margin:0 0 6px;font-size:15px}
.concl .box p{margin:0;font-size:14px;color:var(--ink-soft);line-height:1.5}
.concl .box .hl{color:var(--iodine);font-weight:800}
.hintbox{background:#fff7e8;border:1.5px solid #ffddb0;border-left:5px solid var(--amber);
  border-radius:12px;padding:12px 14px;margin-bottom:14px}
.hintbox .hint{display:flex;gap:8px;align-items:flex-start;font-size:14px;line-height:1.5;color:#6b4e12;font-weight:600}
.hintbox .hint+.hint{margin-top:8px}
.hintbox .hint .ic{flex:none}
.review-item{background:var(--panel-2);border:2px solid var(--line);border-radius:16px;padding:16px;margin-bottom:14px;text-align:left}
.review-item .rq{font-size:14px;font-weight:800;color:#2f9e44;margin-bottom:8px;line-height:1.45}
.review-item .rq .n{display:inline-block;background:#2f9e44;color:#fff;border-radius:999px;padding:1px 9px;margin-right:6px;font-size:13px}
.review-item .ra{background:#fff;border:1.5px dashed var(--line);border-radius:10px;padding:12px 14px;font-size:15px;line-height:1.6;color:var(--ink);white-space:pre-wrap;min-height:24px}
.review-item .ra.empty{color:var(--ink-soft);font-style:italic}

@media (max-width:560px){
  .tray{position:static;margin:10px auto 0;width:190px}
  #phaseTitle{font-size:15px}
}
@media (prefers-reduced-motion:reduce){
  *{animation-duration:.001s!important;transition-duration:.12s!important}
}
</style>
</head>
<body>
<div id="app">
  <div id="topbar">
    <div class="eyebrow">Ⅴ. 식물과 에너지 <small>· 탐구 활동</small></div>
    <div id="phaseTitle">미리 준비하기</div>
    <div class="spacer"></div>
    <button class="mini-btn" id="restartBtn">처음부터</button>
  </div>

  <div id="stage">
    <div class="bench"></div>

    <!-- scenes injected here -->
    <div class="scene" id="scPrep"></div>
    <div class="scene" id="scOxy"></div>
    <div class="scene" id="scMicro"></div>

    <div id="daynight"><div class="sky"></div><div class="sun"></div></div>

    <div id="guidebar"><span class="mascot">🌱</span><span id="guideText">시작해 볼까요?</span></div>
  </div>

  <!-- title -->
  <div id="title">
    <div class="plant">🌿</div>
    <div class="eyebrow2">중학 과학2 · 광합성 탐구</div>
    <h1>광합성으로 만들어지는<br>물질 확인하기</h1>
    <p>검정말과 향불, 현미경으로 광합성의 산물을 직접 찾아봐요</p>
    <button class="big-btn" id="startBtn">시작하기</button>
  </div>

  <!-- question modal (reused for both 정리 questions) -->
  <div class="modal" id="qModal">
    <div class="card">
      <div class="q-eyebrow" id="qEyebrow">정리하기 ①</div>
      <h3 id="qTitle">시험관 A와 B에 꺼져 가는 향불을 넣었을 때<br>각각 어떤 변화가 있었는지 이야기해 보자.</h3>
      <div id="qHints"></div>
      <textarea id="answer" placeholder="관찰한 내용을 자유롭게 적어 보세요. (예: 시험관 A에서는…, 시험관 B에서는…)"></textarea>
      <div class="actions"><button class="submit" id="qSubmit" disabled>제출</button></div>
    </div>
  </div>

  <!-- observation modal -->
  <div class="modal" id="obsModal">
    <div class="card" style="max-width:520px">
      <div class="q-eyebrow">현미경 관찰</div>
      <h3 style="margin-bottom:14px">표본을 선택해 엽록체를 관찰해 보세요</h3>
      <div class="obs-grid" id="obsTabs"></div>
      <div class="field-wrap">
        <div class="field" id="obsField"><div class="mag">400배</div></div>
        <div class="obs-caption" id="obsCap">표본을 선택하세요.</div>
      </div>
      <div class="actions" style="justify-content:space-between;align-items:center">
        <div id="obsProgress" style="font-size:13px;color:var(--ink-soft);font-weight:700"></div>
        <button class="submit" id="toConcl" disabled>다음: 정리 문제</button>
      </div>
    </div>
  </div>

  <!-- review modal: shows both answers together -->
  <div class="modal" id="conclModal">
    <div class="card concl" style="max-width:640px">
      <div class="q-eyebrow">나의 탐구 정리</div>
      <div class="big" style="font-size:20px;margin-bottom:12px">두 정리 문제에 이렇게 답했어요</div>
      <input id="stuName" placeholder="이름을 적어 주세요 (선택)" maxlength="20"
        style="width:100%;border:2px solid var(--line);border-radius:12px;padding:10px 14px;font-family:inherit;font-size:15px;margin-bottom:14px;color:var(--ink)">
      <div id="review"></div>
      <div class="actions" style="justify-content:center;gap:12px;margin-top:16px;flex-wrap:wrap">
        <button class="submit" id="saveImg" style="background:linear-gradient(135deg,#ffb13a,#ffc766);color:#7a4a00">🖼️ 이미지로 저장</button>
        <button class="big-btn amber" id="againBtn" style="font-size:17px;padding:14px 30px">처음부터 다시</button>
      </div>
    </div>
  </div>
</div>

<script>
"use strict";
(function(){
  const $=(s,r=document)=>r.querySelector(s);
  const $$=(s,r=document)=>[...r.querySelectorAll(s)];
  const wait=ms=>new Promise(r=>setTimeout(r,ms));

  const stage=$('#stage'), guidebar=$('#guidebar'), guideText=$('#guideText'), phaseTitle=$('#phaseTitle');
  let locked=false;

  function setPhase(t){ phaseTitle.textContent=t; }
  function guide(t){ guidebar.classList.remove('hide'); guideText.textContent=t; }
  function hideGuide(){ guidebar.classList.add('hide'); }

  // arm: make one or more elements the active tap target(s)
  let armed=[];
  function disarm(){
    armed.forEach(({el,fn})=>{ el.classList.remove('tappable','active'); el.onclick=null; });
    armed=[];
  }
  function arm(els,fn,pad){
    disarm(); locked=false;
    if(!Array.isArray(els)) els=[els];
    els.forEach(el=>{
      el.classList.add('tappable','active');
      el.onclick=async()=>{ if(locked) return; locked=true; disarm(); hideGuide(); await fn(); };
      armed.push({el,fn});
    });
  }

  function tube(label,cls=''){
    const d=document.createElement('div'); d.className='tube '+cls;
    d.innerHTML=`
      <div class="rim"></div>
      <div class="glass">
        <div class="fill"></div>
        <div class="weed">${weedSVG()}</div>
        <div class="bubbles"></div>
      </div>
      <div class="foil"></div>
      <div class="lid"></div>
      <div class="badge">${label}</div>`;
    return d;
  }
  function weedSVG(){
    return `<svg viewBox="0 0 44 180" width="44" height="180">
      <path d="M22 180 C 18 140 26 120 20 90 C 14 60 26 40 22 6" fill="none" stroke="var(--weed-dark)" stroke-width="4" stroke-linecap="round"/>
      ${[...Array(9)].map((_,i)=>{const y=18+i*17;const dir=i%2?1:-1;return `<path d="M${22} ${y} q ${dir*16} -6 ${dir*22} 4 q ${-dir*10} 2 ${-dir*22} -4 Z" fill="var(--weed)" opacity=".95"/>`;}).join('')}
    </svg>`;
  }
  function bubblesIn(t,ms){
    const box=$('.bubbles',t); const end=Date.now()+ms;
    (function spawn(){
      if(Date.now()>end || !box.isConnected) return;
      const b=document.createElement('div'); b.className='bubble';
      const sz=4+Math.random()*7; b.style.width=sz+'px'; b.style.height=sz+'px';
      b.style.left=(18+Math.random()*40)+'px'; b.style.animationDuration=(0.9+Math.random()*0.7)+'s';
      box.appendChild(b); setTimeout(()=>b.remove(),1800);
      setTimeout(spawn,120+Math.random()*140);
    })();
  }

  /* ===================== SCENE: PREP ===================== */
  const scPrep=$('#scPrep');
  function buildPrep(){
    scPrep.innerHTML='';
    const rack=document.createElement('div'); rack.className='rack';
    rack.style.left='calc(50% - 115px)'; rack.style.bottom='9%';
    rack.innerHTML=`<div class="board top"></div><div class="post l"></div><div class="post r"></div>
      <div class="socket" style="left:34px"></div><div class="socket" style="right:34px"></div><div class="board"></div>`;
    scPrep.appendChild(rack);

    const A=tube('A'), B=tube('B');
    A.style.left='calc(50% - 96px)'; A.style.bottom='11%';
    B.style.left='calc(50% + 22px)'; B.style.bottom='11%';
    scPrep.appendChild(A); scPrep.appendChild(B);

    const strawA=document.createElement('div'); strawA.className='straw';
    strawA.style.left='calc(50% - 66px)'; strawA.style.bottom='calc(11% + 82px)';
    const strawB=document.createElement('div'); strawB.className='straw';
    strawB.style.left='calc(50% + 53px)'; strawB.style.bottom='calc(11% + 82px)';
    scPrep.appendChild(strawA); scPrep.appendChild(strawB);

    const foil=document.createElement('div'); foil.className='bottle';
    foil.style.left='calc(50% + 150px)'; foil.style.bottom='11%';
    foil.style.width='72px'; foil.style.height='96px';
    foil.innerHTML=`<div class="body" style="background:repeating-linear-gradient(120deg,#c9ced3 0 5px,#eef1f3 5px 10px,#b6bcc2 10px 15px);border-color:#9aa1a7"></div>
      <div class="lab" style="top:auto;bottom:20px">알루미늄<br>포일</div>`;
    scPrep.appendChild(foil);

    const clock=document.createElement('div'); clock.className='clock';
    clock.style.left='calc(50% + 150px)'; clock.style.bottom='11%'; clock.style.display='none';
    clock.innerHTML=`<div class="m"></div><div class="h"></div><div class="pin"></div>`;
    scPrep.appendChild(clock);

    return {A,B,strawA,strawB,foil,clock};
  }

  async function runPrep(){
    setPhase('미리 준비하기');
    const {A,B,strawA,strawB,foil,clock}=buildPrep();
    await showScene(scPrep);

    // P0 straw — insert into both A and B
    guide('빨대를 눌러 시험관 A·B에 꽂아 보세요');
    arm([strawA,strawB],async()=>{
      strawA.classList.add('in'); strawB.classList.add('in'); await wait(600);
      // P1 breath button
      const btn=floatBtn('숨 불어넣기','50%','calc(11% + 250px)');
      guide('‘숨 불어넣기’ 버튼을 눌러 A·B에 숨을 불어넣어요');
      arm(btn,async()=>{
        btn.remove(); bubblesIn(A,2600); bubblesIn(B,2600); await wait(2700);
        [strawA,strawB].forEach(s=>{ s.style.opacity='0'; s.style.transform='rotate(16deg) translateY(-50px)'; });
        await wait(600); strawA.remove(); strawB.remove();
        // P2 weeds in
        guide('시험관을 눌러 검정말을 넣어 보세요');
        arm([A,B],async()=>{
          A.classList.add('has-weed'); B.classList.add('has-weed'); await wait(700);
          A.classList.add('lid-on'); B.classList.add('lid-on'); await wait(500);
          // P3 foil
          guide('알루미늄 포일을 눌러 시험관 하나를 감싸 보세요');
          arm(foil,async()=>{
            foil.style.transition='.5s'; foil.style.opacity='0'; foil.style.transform='translateX(-60px)';
            B.classList.add('foil-on'); await wait(700); foil.remove();
            // P4 clock
            clock.style.display='block';
            guide('시계를 눌러 하루 동안 빛이 잘 드는 곳에 두세요');
            arm(clock,async()=>{
              await dayNight(clock);
              runOxygen();
            },10);
          });
        });
      });
    });
  }

  function floatBtn(text,left,bottom){
    const b=document.createElement('button'); b.className='big-btn amber';
    b.style.position='absolute'; b.style.left=left; b.style.bottom=bottom; b.style.zIndex='12';
    b.style.fontSize='16px'; b.style.padding='12px 22px'; b.style.transform='translateX(-50%)';
    b.textContent=text; scPrep.appendChild(b); return b;
  }

  async function dayNight(clock){
    guide('하루가 지나가는 중…');
    clock.classList.add('spin');
    const dn=$('#daynight'), sun=$('.sun',dn);
    // stars
    for(let i=0;i<40;i++){const s=document.createElement('div');s.className='star';
      s.style.left=Math.random()*100+'%';s.style.top=Math.random()*60+'%';s.style.opacity=(Math.random()*.7+.3);dn.appendChild(s);}
    dn.style.opacity='.82'; await wait(1700);
    dn.style.opacity='0'; sun.style.opacity='1'; sun.style.top='12%'; sun.style.left='72%';
    await wait(1100); sun.style.opacity='0';
    $$('.star',dn).forEach(s=>s.remove());
    await wait(500);
  }

  /* ===================== SCENE: OXYGEN ===================== */
  const scOxy=$('#scOxy');
  async function runOxygen(){
    setPhase('실험하기 ① 산소 확인');
    scOxy.innerHTML='';
    const rack=document.createElement('div'); rack.className='rack';
    rack.style.left='calc(50% - 115px)'; rack.style.bottom='9%';
    rack.innerHTML=`<div class="board top"></div><div class="post l"></div><div class="post r"></div>
      <div class="socket" style="left:34px"></div><div class="socket" style="right:34px"></div><div class="board"></div>`;
    scOxy.appendChild(rack);
    const A=tube('A','has-weed lid-on'), B=tube('B','has-weed lid-on foil-on');
    A.style.left='calc(50% - 96px)'; A.style.bottom='11%';
    B.style.left='calc(50% + 22px)'; B.style.bottom='11%';
    scOxy.appendChild(A); scOxy.appendChild(B);

    const inc=document.createElement('div'); inc.className='incense';
    inc.style.left='72%'; inc.style.top='46%';
    inc.innerHTML=`<div class="flame"></div><div class="smoke"></div><div class="ember"></div><div class="stick"></div><div class="grip"></div><div class="lbl">향불</div>`;
    scOxy.appendChild(inc);

    await showScene(scOxy);

    guide('시험관 A와 B를 눌러 뚜껑을 열어 보세요');
    arm([A,B],async()=>{
      B.classList.remove('foil-on'); await wait(400);
      A.classList.remove('lid-on'); B.classList.remove('lid-on'); await wait(500);
      // light the incense, then let it die to a glowing ember (꺼져 가는 향불)
      inc.classList.add('lit','burning','smoking'); await wait(1000);
      inc.classList.remove('burning'); await wait(500);
      startIncenseDrag(inc,A,B);
    });
  }

  function emberTip(inc){ const r=inc.getBoundingClientRect(); return {x:r.left+r.width/2, y:r.top+16}; }
  function mouthCenter(tubeEl){ const r=tubeEl.getBoundingClientRect(); return {x:r.left+r.width/2, y:r.top+6}; }

  function makeDraggable(el,onDrop){
    el.classList.add('draggable');
    let on=true, dragging=false, offx=0, offy=0;
    const down=e=>{ if(!on)return; dragging=true; el.style.transition='none';
      try{el.setPointerCapture(e.pointerId);}catch(_){}
      const r=el.getBoundingClientRect(); offx=e.clientX-r.left; offy=e.clientY-r.top; e.preventDefault(); };
    const move=e=>{ if(!dragging)return; const s=stage.getBoundingClientRect();
      el.style.left=(e.clientX-s.left-offx)+'px'; el.style.top=(e.clientY-s.top-offy)+'px'; el.style.bottom='auto'; };
    const up=e=>{ if(!dragging)return; dragging=false; el.style.transition='';
      onDrop(emberTip(el)); };
    el.addEventListener('pointerdown',down);
    el.addEventListener('pointermove',move);
    el.addEventListener('pointerup',up);
    el.addEventListener('pointercancel',up);
    return { disable(){ on=false; el.classList.remove('draggable'); } };
  }

  function startIncenseDrag(inc,A,B){
    const tested={A:false,B:false};
    const rest={left:inc.style.left, top:inc.style.top};
    inc.classList.add('glow-cue');
    guide('향불을 시험관 입구로 살살 끌어다 대 보세요');
    const drag=makeDraggable(inc,async(tip)=>{
      const cand=[[A,'A'],[B,'B']].map(([el,id])=>{const m=mouthCenter(el);return {el,id,d:Math.hypot(tip.x-m.x,tip.y-m.y)};});
      cand.sort((a,b)=>a.d-b.d);
      const near=cand[0];
      if(near.d<78 && !tested[near.id]){
        tested[near.id]=true;
        snapMouth(inc,near.el);
        await wait(450);
        if(near.id==='A'){ await flareAt(A); }
        else { await puffAt(B); }
        if(tested.A && tested.B){
          inc.classList.remove('glow-cue'); drag.disable(); hideGuide();
          await wait(700); inc.style.opacity='0'; await wait(400);
          openQuestion();
        } else {
          guide('남은 시험관 입구에도 향불을 대 보세요');
        }
      } else {
        // not close enough → drift back to rest
        inc.style.left=rest.left; inc.style.top=rest.top; inc.style.bottom='auto';
      }
    });
  }
  function snapMouth(inc,tubeEl){
    const s=stage.getBoundingClientRect(), m=mouthCenter(tubeEl);
    inc.style.left=(m.x-s.left-25)+'px';   // holder width 50 → center on mouth
    inc.style.top=(m.y-s.top-14)+'px';     // ember tip just at the mouth
    inc.style.bottom='auto';
  }
  async function flareAt(tubeEl){
    const s=stage.getBoundingClientRect(), t=tubeEl.getBoundingClientRect();
    const fx=document.createElement('div'); fx.className='flare-fx';
